{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-with-claude"],
  "provider": {
    "hammerllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "HammerLLM",
      "options": {
        "baseURL": "https://tower.hammernet:8080/v1",
        "apiKey": "",
      },
      "models": {
        "hammerllm-active": {
          "name": "Local",
          "limit": {
            "context": 262144,
            "output": 8192,
          },
        },
      },
    },
  },
}
